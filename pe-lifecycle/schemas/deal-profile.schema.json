{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DealProfile",
  "description": "Stammdaten einer Beteiligung. Namen sind vor externen Aufrufen zu pseudonymisieren.",
  "type": "object",
  "required": ["deal_id", "phase_stage", "geography"],
  "properties": {
    "deal_id": {"type": "string", "description": "stabile ID, z. B. projekt-alpha"},
    "target_name": {"type": "string", "description": "Klarname (bleibt lokal, nie extern)"},
    "phase_stage": {"type": "string", "enum": ["seed", "series-a", "series-b", "growth", "buyout"]},
    "geography": {"type": "object", "properties": {"hq_country": {"type": "string"}, "hq_canton": {"type": "string"}, "subsidiaries": {"type": "array", "items": {"type": "string"}}}},
    "round": {"type": "object", "properties": {"currency": {"type": "string"}, "round_size": {"type": "number"}, "pre_money": {"type": "number"}, "our_ticket": {"type": "number"}, "our_stake_fd_pct": {"type": "number"}}},
    "kpis": {"type": "object", "properties": {"arr": {"type": "number"}, "arr_yoy_pct": {"type": "number"}, "gross_margin_pct": {"type": "number"}, "net_burn_monthly": {"type": "number"}, "cash": {"type": "number"}, "nrr_pct": {"type": "number"}}},
    "flags": {"type": "array", "items": {"type": "string"}, "description": "bekannte Besonderheiten (Kundenklumpen, IP-Fragen, ESOP …)"}
  }
}
